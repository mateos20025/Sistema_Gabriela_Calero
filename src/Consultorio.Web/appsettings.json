{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/consultorio-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "BaseDatos": {
    "AplicarMigracionesAlIniciar": true
  },
  "Consultorio": {
    "Nombre": "Consultorio Dra. Gabriela Calero",
    "NombreCorto": "Consultorio"
  },
  "ProteccionDatos": {
    "VersionPoliticaPrivacidad": "1.0",
    "RutaPoliticaPrivacidad": ""
  },
  "Turnstile": {
    "ClaveSitio": "",
    "ClaveSecreta": ""
  },
  "Archivos": {
    "RutaBase": "almacen"
  }
}
