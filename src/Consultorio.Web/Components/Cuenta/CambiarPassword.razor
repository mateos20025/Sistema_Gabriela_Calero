@page "/cuenta/cambiar-password"
@attribute [Authorize]
@inject IServicioCuenta ServicioCuenta

<PageTitle>Cambiar contraseña · Consultorio</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Cambiar contraseña</MudText>

@if (cambiada)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" role="status">Tu contraseña se actualizó correctamente.</MudAlert>
    <MudButton Href="@RutasCuenta.Panel" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Ir al panel</MudButton>
}
else
{
    @if (debeCambiar)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Estás usando una contraseña temporal. Por seguridad, crea una contraseña propia antes de continuar.
        </MudAlert>
    }

    @if (errores.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">
            @foreach (var error in errores)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    <EditForm Model="Input" FormName="cambiar-password" method="post" OnValidSubmit="CambiarAsync" novalidate>
        <ValidadorFluent />

        <div class="campo">
            <label for="actual">Contraseña actual</label>
            <InputText id="actual" type="password" @bind-Value="Input.PasswordActual" autocomplete="current-password" />
            <ValidationMessage For="() => Input.PasswordActual" />
        </div>

        <div class="campo">
            <label for="nueva">Nueva contraseña</label>
            <InputText id="nueva" type="password" @bind-Value="Input.NuevaPassword" autocomplete="new-password" aria-describedby="ayuda-nueva" />
            <span id="ayuda-nueva" class="campo-ayuda">
                Mínimo @PoliticaPassword.LongitudMinima caracteres, con mayúscula, minúscula y número.
            </span>
            <ValidationMessage For="() => Input.NuevaPassword" />
        </div>

        <div class="campo">
            <label for="confirmar">Repite la nueva contraseña</label>
            <InputText id="confirmar" type="password" @bind-Value="Input.ConfirmarPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmarPassword" />
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Class="mt-2">Guardar contraseña</MudButton>
    </EditForm>

    @if (!debeCambiar)
    {
        <MudButton Href="@RutasCuenta.Panel" Variant="Variant.Text" FullWidth="true" Class="mt-2">Volver al panel</MudButton>
    }

    <form action="@RutasCuenta.CerrarSesion" method="post" class="mt-2">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true">Cerrar sesión</MudButton>
    </form>
}

@code {
    private bool cambiada;
    private bool debeCambiar;
    private IReadOnlyList<string> errores = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private CambiarPasswordComando Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        debeCambiar = Politicas.DebeCambiarPassword(HttpContext.User);
    }

    private async Task CambiarAsync()
    {
        var resultado = await ServicioCuenta.CambiarPasswordAsync(Input, HttpContext.RequestAborted);
        cambiada = resultado.Exito;
        errores = resultado.Errores;

        // No devolver contraseñas escritas dentro del HTML de la respuesta.
        Input.PasswordActual = "";
        Input.NuevaPassword = "";
        Input.ConfirmarPassword = "";
    }
}
