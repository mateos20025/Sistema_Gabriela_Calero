@inherits LayoutComponentBase

@* Diseño por defecto del enrutador (páginas interactivas sin diseño propio). Usa el mismo encabezado y pie del sitio. *@

<MudThemeProvider Theme="TemaConsultorio.Tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="sitio">
    <EncabezadoSitio />
    <main id="contenido">
        @Body
    </main>
    <PieSitio />
    <BotonWhatsapp />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">&times;</button>
</div>
