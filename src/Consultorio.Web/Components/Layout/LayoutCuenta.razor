@inherits LayoutComponentBase
@inject NavigationManager Navegacion
@inject IOptions<OpcionesConsultorio> Consultorio
@inject IOptionsMonitor<OpcionesSitioPublico> Sitio

<MudThemeProvider Theme="TemaConsultorio.Tema" />

@if (HttpContext is null)
{
    <p class="cuenta-cargando">Cargando…</p>
}
else
{
    <main class="cuenta-fondo">
        <div class="cuenta-contenedor">
            <a href="/" class="cuenta-marca" aria-label="@Consultorio.Value.Nombre">
                @if (string.IsNullOrWhiteSpace(Sitio.CurrentValue.LogoCompleto))
                {
                    <EmblemaMarca />
                    <strong>@Consultorio.Value.Nombre</strong>
                }
                else
                {
                    <img src="@Sitio.CurrentValue.LogoCompleto" alt="@Consultorio.Value.Nombre" class="cuenta-logo" width="720" height="378" />
                }
            </a>
            <MudPaper Elevation="0" Class="pa-6 pa-sm-8 cuenta-tarjeta">
                @Body
            </MudPaper>
        </div>
    </main>
}

@code {
    // Las páginas de cuenta escriben la cookie de sesión, así que necesitan una petición HTTP real.
    // Si se llega aquí navegando desde una pantalla interactiva no hay HttpContext: se recarga la página
    // completa para que el servidor la genere de forma estática.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            Navegacion.Refresh(forceReload: true);
        }
    }
}
