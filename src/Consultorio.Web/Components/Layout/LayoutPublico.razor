@inherits LayoutComponentBase

<MudThemeProvider Theme="TemaConsultorio.Tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="mr-2" />
        <MudText Typo="Typo.h6">Consultorio Dra. Gabriela Calero</MudText>
        <MudSpacer />
        <MudButton Href="@RutasCuenta.Panel" Variant="Variant.Text" Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.Lock">Personal</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
