@inherits LayoutComponentBase
@inject NavigationManager Navegacion

@* Diseño del sitio público (inicio, solicitar cita, privacidad). Se genera en el servidor como HTML normal:
   carga rápido, lo leen los buscadores y funciona con el captcha y el límite de envíos. *@

<MudThemeProvider Theme="TemaConsultorio.Tema" />

@if (HttpContext is null)
{
    <p class="cuenta-cargando">Cargando…</p>
}
else
{
    @* data-enhance-nav="false": cada enlace carga la página completa (lo necesita el captcha de "Solicitar cita"). *@
    <div class="sitio" data-enhance-nav="false">
        <a href="#contenido" class="saltar-al-contenido">Saltar al contenido</a>
        <EncabezadoSitio />
        <main id="contenido">
            @Body
        </main>
        <PieSitio />
        <BotonWhatsapp />
    </div>
}

@code {
    // Si se llega navegando desde una pantalla interactiva no hay HttpContext: se recarga la página
    // completa para que el servidor la genere de forma estática (igual que las páginas de cuenta).
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            Navegacion.Refresh(forceReload: true);
        }
    }
}
