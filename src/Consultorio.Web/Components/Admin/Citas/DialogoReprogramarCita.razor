@inject ReprogramarCita Reprogramar

@* Mover la cita a otro horario libre. Queda "Reprogramada" hasta que el paciente confirme. *@

<MudDialog>
    <DialogContent>
        <MensajesError Errores="errores" />

        <MudText Class="mb-4">
            Horario actual: <strong>@Formato.FechaHoraLarga(InicioActualUtc)</strong>
        </MudText>

        <SelectorHorario @bind-Seleccionado="nuevoInicio" ExcluirCitaId="CitaId" />

        <MudTextField T="string" @bind-Value="observacion" Label="Motivo u observación (opcional)" Variant="Variant.Outlined"
                      Lines="2" Class="mt-4" MaxLength="@Cita.LongitudMaximaObservacion" Counter="@Cita.LongitudMaximaObservacion" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="guardando || nuevoInicio is null">
            Reprogramar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid CitaId { get; set; }

    [Parameter, EditorRequired]
    public DateTime InicioActualUtc { get; set; }

    private DateTime? nuevoInicio;
    private string? observacion;
    private IReadOnlyList<string> errores = [];
    private bool guardando;

    private async Task GuardarAsync()
    {
        guardando = true;
        var resultado = await Reprogramar.EjecutarAsync(CitaId, nuevoInicio, observacion, CancellationToken.None);
        guardando = false;

        if (!resultado.Exito)
        {
            errores = resultado.Errores;
            return;
        }

        Dialogo.Close(DialogResult.Ok(true));
    }
}
