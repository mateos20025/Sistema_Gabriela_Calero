@page "/"

<Titulo />

<MudPaper Elevation="1" Class="pa-8">
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Te damos la bienvenida</MudText>
    <MudText Class="mb-6">
        Solicita tu cita en línea: elige el día y la hora que prefieras y el consultorio te llamará para confirmarla.
    </MudText>
    <MudButton Href="@RutasPublicas.SolicitarCita" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.EventAvailable" Class="mb-6">
        Solicitar cita
    </MudButton>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        También puedes comunicarte directamente con el consultorio para agendar tu cita.
        Consulta nuestra <MudLink Href="@RutasPublicas.Privacidad" Typo="Typo.body2">política de privacidad</MudLink>.
    </MudText>
</MudPaper>
